# ===== Telegram =====
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF
# Public URL of the Mini App (HTTPS, must be set in @BotFather as Web App URL)
WEBAPP_URL=https://your-domain.example.com
# Optional admin Telegram IDs (comma-separated)
ADMIN_IDS=

# ===== Server =====
# Bind host/port for FastAPI (uvicorn)
HOST=0.0.0.0
PORT=8000
# Base URL the backend uses to build links (typically same as WEBAPP_URL)
PUBLIC_BASE_URL=https://your-domain.example.com
# Random 64-byte hex string. Used to sign JWT session tokens.
JWT_SECRET=change-me-please-very-long-random-string
JWT_TTL_SECONDS=86400
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://your-domain.example.com

# ===== Database =====
# SQLAlchemy URL. Default is local SQLite.
DATABASE_URL=sqlite+aiosqlite:///./data/aurora.db

# ===== Casino economy =====
# Currency code shown to users (display only)
CURRENCY_CODE=AC
CURRENCY_NAME=Aurora Coins
# Welcome bonus on first deposit (percent, e.g. 100 = +100% to first deposit)
WELCOME_BONUS_PCT=100
WELCOME_BONUS_MAX=10000
# Daily bonus amount (claimable every 24h)
DAILY_BONUS_AMOUNT=50
# Weekly cashback percent on net losses
CASHBACK_PCT=10
# Wagering requirement multiplier for bonus money before withdrawal
BONUS_WAGER_X=30
# Min/max bet
MIN_BET=10
MAX_BET=100000
# Max win per single round (anti-jackpot exploit cap)
MAX_WIN=1000000

# ===== House edge / RTP per game =====
# These are the only knobs that determine how favourable each game is.
# RTP = 100 - house_edge_pct. All games use a CERTIFIED-style provably-fair
# RNG (HMAC-SHA512 of server_seed with client_seed:nonce) and outcomes are NOT
# manipulated per-user. The casino's mathematical edge comes purely from these
# values, exactly as in licensed casinos.
HOUSE_EDGE_DICE=1.0
HOUSE_EDGE_CRASH=1.0
HOUSE_EDGE_MINES=1.0
HOUSE_EDGE_COINFLIP=2.0
HOUSE_EDGE_SLOTS=4.0
HOUSE_EDGE_ROULETTE=2.7
HOUSE_EDGE_PLINKO=1.0
HOUSE_EDGE_WHEEL=4.0
HOUSE_EDGE_HILO=2.0
HOUSE_EDGE_LIMBO=1.0

# ===== Referral system =====
# Percent of friend's wager that goes to referrer's referral balance
REFERRAL_PCT=1.0
# Lifetime referral cap per referee (in casino currency)
REFERRAL_CAP=1000000

# ===== Rukassa (rukassa.io / rukassa.is) =====
RUKASSA_SHOP_ID=
RUKASSA_TOKEN=
RUKASSA_TOKEN_PAYOUT=
# Webhook secret used to verify the Rukassa->our backend signature
RUKASSA_WEBHOOK_SECRET=
# Min/max deposit & withdrawal in fiat (RUB by default)
DEPOSIT_MIN_RUB=100
DEPOSIT_MAX_RUB=300000
WITHDRAW_MIN_RUB=500
WITHDRAW_MAX_RUB=300000
# Rate: how many casino coins user gets per 1 RUB deposited
COINS_PER_RUB=1.0
